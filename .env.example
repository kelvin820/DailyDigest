# Default: four real-source review stories, public read-only; no account required.
READING_MODE=public
# Historical eight-story fictional fixtures are only for offline QA.
DEMO_MODE=false
APP_URL=http://localhost:3000
APP_TIMEZONE=Asia/Taipei
NODE_USE_ENV_PROXY=1
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# New Vercel resource connection (custom prefix); this complete pair wins.
DAILY_DIGEST_SUPABASE_URL=
DAILY_DIGEST_SUPABASE_SECRET_KEY=
DAILY_DIGEST_POSTGRES_URL=
# Older unprefixed Marketplace connection, used only without the above pair.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Private editor password, at least 24 characters; never NEXT_PUBLIC_.
EDITOR_ACTION_SECRET=
# Server-only authentication for the daily Vercel Cron trigger.
CRON_SECRET=
# Optional separate NVIDIA image key; blank reuses the existing NVIDIA LLM key.
NVIDIA_IMAGE_API_KEY=
MAX_IMAGE_CALLS_PER_DAY=16
LIVE_GENERATION_ENABLED=false
LLM_PROVIDER=nvidia
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
WRITER_MODEL=nvidia/nemotron-3-ultra-550b-a55b
REVIEWER_MODEL=nvidia/nemotron-3-ultra-550b-a55b
LLM_INPUT_USD_PER_MILLION=
LLM_OUTPUT_USD_PER_MILLION=
DAILY_BUDGET_USD=2
MAX_MODEL_CALLS=100
MAX_MODEL_TOKENS=200000
PUBLISH_MODE=review
DRAFT_ONLY=true
RESUME=true
FORCE_NEW_REVISION=false
DD_PIPELINE_ACCEPTED=false
SEARCH_ENABLED=false
GITHUB_REPOSITORY=
GITHUB_DISPATCH_TOKEN=
GITHUB_DEFAULT_BRANCH=main
# Optional operator-approved fact bundle path; blank uses the audited-source intake.
APPROVED_FACTS_FILE=
# ISSUE_DATE=2026-11-18

